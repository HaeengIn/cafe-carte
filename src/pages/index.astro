---
import Fanding from "@components/Fanding.astro";
import MemberList from "@components/MemberList.astro";
import Layout from "@layouts/Layout.astro";
import { imgBucketUrl } from "../config";
import "@styles/index.css";
---

<Layout title="홈 | 카페 카르테">
  <div class="home">
    <p class="description">
      TWILLIT STUDIO의 3D VTuber 그룹, 카페 카르테의 비공식 팬 웹사이트. 모코
      파르페, 한서린, 댕키, 유우희, 에루 솔스티스를 포함한 멤버들과 카페
      카르테에 대해 알아보세요.
    </p>
    <div class="front">
      <img
        class="front-image fade-down"
        src={`${imgBucketUrl}/cafe-carte/front.avif`}
        alt="카페 카르테 대문"
        width={1280}
        height={600}
      />
    </div>
    <MemberList />
    <Fanding />
  </div>
</Layout>
